# Gov Funding Monitor 환경변수
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요.
# cp .env.example .env

# AWS
AWS_REGION=ap-northeast-2
S3_BUCKET=gov-funding-monitor-snapshots
ANTHROPIC_API_PROVIDER=bedrock

# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_CHANNEL_ID=C0XXXXXXXXX
GOV_FUNDING_CHANNEL_ID=C0XXXXXXXXX
AI_NEWS_CHANNEL_ID=C0XXXXXXXXX
AI_NEWS_S3_BUCKET=ai-news-articles

# Gmail (optional)
GMAIL_CREDENTIALS=
EMAIL_RECIPIENTS=your-email@example.com

# Filtering
RELEVANCE_THRESHOLD=0.7
DEADLINE_ALERT_DAYS=7

# Bedrock
BEDROCK_MODEL_ID=global.anthropic.claude-opus-4-6-v1
BEDROCK_REGION=us-west-2
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Claude CLI Auth
CLAUDE_CODE_USE_BEDROCK=1
AWS_BEARER_TOKEN_BEDROCK=your-bearer-token

# Claude Code 빠른 모델 (선택)
ANTHROPIC_SMALL_FAST_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0
ANTHROPIC_SMALL_FAST_MODEL_AWS_REGION=us-west-2
